# Host port that forwards to the Switchboard container's internal port 8000.
# Change this if 8000 is already in use locally.
PORT=8000

# The docker-compose file bind-mounts ../storage and ../.agent relative to this
# ops/ directory. Create those directories before starting Compose if they do
# not already exist so data persists on the host.

# Uncomment the lines below to override the default persistence locations.
# The defaults keep data under /app when running in Docker.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/switchboard.db
# STORAGE_ROOT=/absolute/path/to/storage
# FILES_ROOT=/absolute/path/to/storage/files
# Rate limiting controls (set requests/window to 0 to disable enforcement).
# SWITCHBOARD_RATE_LIMIT_REQUESTS=120
# SWITCHBOARD_RATE_LIMIT_WINDOW_SECONDS=60
# SWITCHBOARD_RATE_LIMIT_TRUSTED_BYPASS=
# SWITCHBOARD_LEASE_SECONDS=300

# Manual outbound GitHub exact-PR adapter. Keep the PAT blank in examples and
# provision it only through the operator/server secret environment.
# Minimum fine-grained repository permissions:
#   Metadata: read
#   Pull requests: read and write
# SWITCHBOARD_GITHUB_TOKEN=
# SWITCHBOARD_GITHUB_API_URL=https://api.github.com
# SWITCHBOARD_OPERATOR_ID=local-operator
